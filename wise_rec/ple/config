{
  name: 'daple_model_train',
  tasks: [
    {
      name: 'load_train_dataset',
      type: 'tensorflow::load_train_valid_test_dataset',
      parameters: {
        feature_config_path: '$data_dir$scenName/$modelID/config/$date/WiseRec/feature_config.json',
        feature_map_path : '$data_dir$scenName/$modelID/config/$date/WiseRec/feature_map.json',
        dataset_config: train_dataset_config,
        exclude_features: [ ],
        overwrite_feature_config: {
          
          },
          override_feature_config: {
         
        },
      },
      outputs: ['train']
    },
    {
      name: "load_valid_dataset",
      type: "tensorflow::load_dataset",
      parameters: {
        feature_config_path: '$data_dir$scenName/$modelID/config/$date/WiseRec/feature_config.json',
        feature_map_path : '$data_dir$scenName/$modelID/config/$date/WiseRec/feature_map.json',
        dataset_config: valid_dataset_config,
        exclude_features: [ ],
        overwrite_feature_config: {
        
          },
          override_feature_config: {
        
        },
      },
      outputs: "data",
    },

    {
      name: "load_test_dataset",
      type: "tensorflow::load_dataset",
      parameters: {
        feature_config_path: '$data_dir$scenName/$modelID/config/$date/WiseRec/feature_config.json',
        feature_map_path : '$data_dir$scenName/$modelID/config/$date/WiseRec/feature_map.json',
        dataset_config: test_dataset_config,
        exclude_features: [ ],
        overwrite_feature_config: {
       
        },
        override_feature_config: {
       
      },
    },
      outputs: "data",
    },
    {
      name: 'train_model',
      type: 'tensorflow::train',
      parameters: {
        trainer: trainer_config,
        model: daple_model,
        train_dataset: 'ref::load_train_dataset.train',
        valid_dataset: 'ref::load_valid_dataset.data',
      },
      outputs: ['model'],
    },

    {
      name: 'test_model',
      type: 'tensorflow::test',
      parameters: {
        model: 'ref::train_model.model',
        dataset: 'ref::load_test_dataset.data',
        save_result: true,
        metrics:[
          { type: "auc", predict: 'label', label: 'label', name: 'global_auc' },
          {
            type:"ads_gauc",
