


  //daple
local model_structure = [
  {
    name: 'input',
    type: 'feature_embedding',
    parameters: {
      methods: {
        'features#discrete': {
          type: 'embedding',
          mask_zero: true,
          output_dim: 8,
        },
        }
    },
    inputs: {
      inputs: "ref::inputs.`features#discrete`", //只用离散特征
    },
    outputs: 'embedding',
  },
  {
    name: 'postprocess',
    type: 'feature_sequential',
    parameters: {
      methods: {
        'features#multiple_discrete': [{ type: 'average', axis: 1 }],
        'features#single_discrete': [{"type": "max", "axis": 1}],
      },
    },
    inputs: { inputs: 'ref::input.embedding' },
    outputs: 'embedding',
  },
  {
    name: 'se_net',
    type: 'senet',
    parameters: { reduction_ratio: 3, senet_type: 'elements', first_activation: 'relu', last_activation: 'relu', kernel_initializer: 'glorot_uniform' },
    inputs: {inputs: ['ref::values(postprocess.embedding)'],},
    outputs: 'output',
  },
  {
    name: 'concat_all',
    type: 'concatenate',
    inputs: {
      inputs: 'ref::se_net.output',
    },
    outputs: 'embedding',
  },
  {
    name: 'ple_net',
    type: 'ple',
    parameters: {
        layer_num:2,
        cgc_config: {
            type:"cgc",
            task_num: 6,
            expert_num: 2,
            shared_num: 1,
            use_shared_status: true,
            expert_net_config: {
                type:"dense",
                units: 128,
                kernel_initializer: "truncated_normal",
            },
            shared_net_config: {
                type:"dense",
                units: 128,
                kernel_initializer: "truncated_normal",
            },
            gate_config: {
                type:"mlp_gate",
                extra_proj_config:{
                    type:'dnn',
                    hidden_dims: [128],
                    hidden_activation: "relu",
                    output_activation: "sigmoid"
                }
            },
        }
  },
  inputs: { inputs: ['ref::concat_all.embedding', 'ref::concat_all.embedding', 'ref::concat_all.embedding'] },
  outputs: 'output',
},
{
  name: 'domain_tower',
  type: "loop",
  parameters: {
    loop: {
      type: "simpe_tower",
      tower_net_config:{
          type:'dnn',
          hidden_dims: [128,64,64],
          hidden_activation: "relu",
          output_activation: "relu",
      }
    },
  },
  inputs: {
    inputs: "ref::ple_net.output",
  },
  outputs: "output",
},
{
  name: 'domain_tower_activate',
  type:'loop',
  parameters: {
      loop: {
         type:'dense',
         units: 1,
         activation: 'sigmoid',
      },
  },
  inputs: {
    inputs: "ref::domain_tower.output",
  },
  outputs: "output",

},
{
  name: 'domain_id_cast',
  type: 'string_expression',
  parameters:{
      expression:"cast(domain_id,'int32')"
  },
  inputs:{
    inputs:{
        domain_id:"ref::inputs.domain_id"
    }
},
  outputs:'domain_id'
},
{
  name: 'linear',
  type: 'scene_routing',
  inputs: {
    inputs: ['ref::domain_tower_activate.output', 'ref::domain_id_cast.domain_id']
  },
  outputs: 'logit',
},
];

local daple_model = {
name: 'daple',
structure: model_structure,
inputs: 'inputs',
outputs: {
  label: 'ref::linear.logit',
  prediction:'ref::linear.logit'
}
};

// 训练配置
local trainer_config = {
  type: 'gradient_descent',
  gpu_id: '0,1,2,3',
  seed: 123,
//  train_strategy: 'mirrored',
  epoch: 3,
  optimizer: {
    type: 'adam',
    lr: 0.0001,
    //clipnorm: 5,
  },
  callbacks: [
      {
        type: "early_stopping",
        patience: 2,
        min_delta: 0.001,
        monitor: "val_label_auc",
        restore_best_weights: true,
        mode: "max",
        verbose: 1,
      },
    { type: 'n_batch_logger', interval: 100},
    //{type: 'model_checkpoint', filepath:'../tests/outputs'},
  ],
  compile_config: {
    label: {  // 标签名
      loss: { type: 'binary_cross_entropy', weight: 1.0, },
      metrics: [{ type: 'auc' }],
    },
  },
  //extra_losses: [{type:'mean_predict',predict: 'ref::linear.logit',label:'ref::linear.logit'}],
  //extra_metrics: [{type:'reduce_mean',predict: 'ref::linear.logit',label:'ref::linear.logit'}]
};



